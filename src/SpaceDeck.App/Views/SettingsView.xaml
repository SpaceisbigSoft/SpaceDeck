<UserControl x:Class="SpaceDeck.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,18,0">

      <!-- Display -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
          <DockPanel Margin="0,12,0,0">
            <ComboBox DockPanel.Dock="Right" Width="280" ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}"
                      AutomationProperties.Name="Look">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Look" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>
          <DockPanel Margin="0,12,0,0">
            <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding TemperatureUnits}" SelectedItem="{Binding TemperatureUnit}" />
            <TextBlock Text="Temperature unit" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>
          <DockPanel Margin="0,12,0,0">
            <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}" AutomationProperties.Name="Accent color">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="14" Height="14" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Accent color" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>
          <DockPanel Margin="0,12,0,0">
            <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" DisplayMemberPath="Label"
                      AutomationProperties.Name="Text and layout size" />
            <TextBlock Text="Text and layout size" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>
          <DockPanel Margin="0,12,0,0">
            <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding ClockFormats}" SelectedItem="{Binding ClockFormat}" DisplayMemberPath="Label"
                      AutomationProperties.Name="Clock" />
            <TextBlock Text="Clock" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Sensors -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="Sensors" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding CustomizationSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
          <WrapPanel Margin="0,12,0,0">
            <Button Content="Export board profile…" Command="{Binding ExportBoardProfileCommand}" Margin="0,0,8,0"
                    ToolTip="Save your renames, hidden sensors and corrections to share with people who have the same motherboard." />
            <Button Content="Import board profile…" Command="{Binding ImportBoardProfileCommand}" Margin="0,0,8,0" />
            <Button Content="Reset all" Command="{Binding ResetCustomizationsCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Visibility="{Binding ProfileStatus, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>

      <!-- Window & tray -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="Window &amp; tray" Style="{StaticResource SectionTitle}" />
          <CheckBox Content="Closing the window keeps SpaceDeck running in the tray" IsChecked="{Binding CloseToTray}" Margin="0,12,0,0" />
          <CheckBox Content="Minimizing sends SpaceDeck to the tray" IsChecked="{Binding MinimizeToTray}" Margin="0,8,0,0" />
          <CheckBox Content="Start with Windows (in the tray)" IsChecked="{Binding StartWithWindows}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding StartupStatus}" Foreground="{DynamicResource Skin.Critical}" Margin="0,6,0,0"
                     Visibility="{Binding StartupStatus, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Alerts keep working while SpaceDeck is in the tray. Hover the tray icon for temperatures; right-click it to open or exit." />
        </StackPanel>
      </Border>

      <!-- Sidebar -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28" DataContext="{Binding Sidebar}">
        <StackPanel>
          <TextBlock Text="Sidebar" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="A dashboard docked to the left or right edge of a monitor, full height. Reserving screen space works like a second taskbar: other windows and maximized apps stop at its edge. Right-click the sidebar for the same options." />
          <CheckBox Content="Show the sidebar" IsChecked="{Binding Enabled}" Margin="0,12,0,0" />
          <StackPanel Margin="0,4,0,0" IsEnabled="{Binding Enabled}">
            <DockPanel Margin="0,8,0,0">
              <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding Dashboards}" SelectedItem="{Binding Dashboard}" DisplayMemberPath="Name"
                        AutomationProperties.Name="Sidebar dashboard" />
              <TextBlock Text="Dashboard" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
              <!-- Icon font on the inner TextBlock only: on the Button the tooltip would inherit it (boxes). -->
              <Button DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding RefreshMonitorsCommand}"
                      ToolTip="Look for monitors again" AutomationProperties.Name="Refresh monitors">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
              </Button>
              <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding MonitorList}" SelectedItem="{Binding Monitor}" DisplayMemberPath="Label"
                        AutomationProperties.Name="Sidebar monitor" />
              <TextBlock Text="Monitor" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
              <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding Edges}" SelectedItem="{Binding Edge}" DisplayMemberPath="Label"
                        AutomationProperties.Name="Sidebar edge" />
              <TextBlock Text="Edge" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
              <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding Widths}" SelectedItem="{Binding Width}" DisplayMemberPath="Label"
                        AutomationProperties.Name="Sidebar width" />
              <TextBlock Text="Width" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
              <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SizeOption}" DisplayMemberPath="Label"
                        AutomationProperties.Name="Sidebar content size" />
              <TextBlock Text="Size" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Text="Fit to screen height makes text and rows slightly smaller until every row fits (down to 70 %; then it scrolls). On top of the UI size under Display." />
            <CheckBox Content="Reserve screen space (windows stay clear of it)" IsChecked="{Binding ReserveSpace}" Margin="0,12,0,0" />
            <CheckBox Content="Hide while a game or video is fullscreen on that monitor" IsChecked="{Binding HideWhenFullscreen}" Margin="0,8,0,0" />
          </StackPanel>
          <WrapPanel Margin="0,12,0,0">
            <Button Content="Build or update sidebar…" Margin="0,0,8,8" Command="{Binding BuildCommand}" Style="{DynamicResource AccentButtonStyle}" />
          </WrapPanel>
          <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                     Text="Build sidebar lets you tick sections (CPU with every core's clock and temperature, GPU, RAM, drives, network…) and stacks them into a narrow dashboard. Any other dashboard works too: wider ones are rearranged to fit." />
          <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>

      <!-- Network dashboard -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28" DataContext="{Binding Remote}">
        <StackPanel>
          <TextBlock Text="Network dashboard" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Shows your dashboards, live, in a browser on another device on your home network: a Steam Deck (desktop-mode browser), an Android phone or tablet, another PC. Only devices you pair with the PIN can connect; nothing is reachable from the internet." />
          <CheckBox Content="Serve dashboards on the home network" IsChecked="{Binding Enabled}" Margin="0,12,0,0" />
          <TextBlock Text="{Binding Server.Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />

          <StackPanel Visibility="{Binding Server.IsRunning, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
            <TextBlock Text="On the other device, open:" Foreground="{DynamicResource Skin.Text}" />
            <TextBox Text="{Binding AddressText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,4"
                     FontFamily="{DynamicResource Skin.Font.Mono}" FontSize="16" Foreground="{DynamicResource Skin.Accent}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="PIN" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" Margin="0,0,10,0" />
              <TextBox Text="{Binding Pin, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                       FontFamily="{DynamicResource Skin.Font.Mono}" FontSize="22" VerticalAlignment="Center" />
              <Button Content="New PIN" Command="{Binding NewPinCommand}" Margin="14,0,0,0" VerticalAlignment="Center" />
              <Button Content="Open here" Command="{Binding OpenInBrowserCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None">
              <Run Text="{Binding Server.ClientCount, Mode=OneWay}" /><Run Text=" device(s) watching now. Steam Deck: open the address in the browser, then press the ⛶ button for full screen. Android: Chrome menu → Add to Home screen." />
            </TextBlock>
          </StackPanel>

          <CheckBox Content="Paired devices may switch the fan profile" IsChecked="{Binding AllowControl}" Margin="0,12,0,0" />
          <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Apply" Command="{Binding ApplyPortCommand}" Margin="8,0,0,0" />
            <TextBox DockPanel.Dock="Right" Width="90" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" AutomationProperties.Name="Port" />
            <TextBlock Text="Port" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>

          <TextBlock Text="Paired devices" Style="{StaticResource Caption}" Margin="0,14,0,4" />
          <TextBlock Text="None yet." Style="{StaticResource Caption}" Foreground="{DynamicResource Skin.TextFaint}"
                     Visibility="{Binding HasNoDevices, Converter={StaticResource VisibleWhen}}" />
          <ItemsControl ItemsSource="{Binding Devices}" x:Name="DeviceList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Button DockPanel.Dock="Right" Content="Remove" Padding="10,2"
                          Command="{Binding DataContext.ForgetCommand, ElementName=DeviceList}" CommandParameter="{Binding}" />
                  <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}">
                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Seen, Mode=OneWay}" Foreground="{DynamicResource Skin.TextMuted}" />
                  </TextBlock>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Phone notifications -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28" DataContext="{Binding Remote}">
        <StackPanel>
          <TextBlock Text="Phone notifications (ntfy)" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Alerts can also go to your phone through ntfy, a free app (Android and iPhone). Install it, tap +, and subscribe to the topic below. This sends alert text (sensor name and reading) off this PC to the ntfy server; quiet hours apply." />
          <CheckBox Content="Send alerts to my phone" IsChecked="{Binding NtfyEnabled}" Margin="0,12,0,0" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Topic" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
            <TextBox Grid.Column="1" Text="{Binding NtfyTopic}" Padding="8,5" FontFamily="{DynamicResource Skin.Font.Mono}" AutomationProperties.Name="ntfy topic" />
            <TextBlock Grid.Row="1" Text="Server" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" Margin="0,8,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NtfyServer}" Padding="8,5" Margin="0,8,0,0" AutomationProperties.Name="ntfy server" />
            <TextBlock Grid.Row="2" Text="Access token" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" Margin="0,8,0,0" />
            <!-- A PasswordBox can't bind: the code-behind fills it on Loaded and saves it on LostFocus. -->
            <PasswordBox x:Name="NtfyTokenBox" Grid.Row="2" Grid.Column="1" Padding="8,5" Margin="0,8,0,0" AutomationProperties.Name="ntfy access token"
                         Loaded="NtfyTokenBox_Loaded" LostFocus="NtfyTokenBox_LostFocus" />
          </Grid>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource Skin.Warning}"
                     Text="The server is an http:// address, so the access token is sent unencrypted. Use https:// unless the server is on your home network."
                     Visibility="{Binding NtfyTokenSentInClear, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Keep the long random topic: on the public ntfy.sh server anyone who knows a topic can read it. The access token is only for protected or self-hosted servers." />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Send test" Command="{Binding TestNtfyCommand}" />
            <Button Content="Open topic in browser" Command="{Binding OpenTopicCommand}" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding NtfyStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Visibility="{Binding NtfyStatus, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>

      <!-- Shortcuts -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" />
          <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Apply" Command="{Binding ApplyHotkeyCommand}" Margin="10,0,0,0" />
            <TextBox DockPanel.Dock="Right" Width="160" Text="{Binding OverlayHotkey, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                     AutomationProperties.Name="Show/hide dashboard windows shortcut" />
            <TextBlock Text="Show/hide dashboard windows (works in games)" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>
          <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />
          <DockPanel Margin="0,12,0,0">
            <TextBox DockPanel.Dock="Right" Width="160" Text="{Binding ClickThroughHotkey, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,62,0"
                     AutomationProperties.Name="Click-through shortcut" />
            <TextBlock Text="Click-through on/off for dashboard windows" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>
          <TextBlock Text="{Binding ClickThroughHotkeyStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Leave empty to turn it off. In the main window, Ctrl+1–9 opens a dashboard tab; in a dashboard window, ←/→ or 1–9 switch dashboards (right-click it to rotate them automatically)." />
        </StackPanel>
      </Border>

      <!-- Collector -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="Collector service" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
            <Run Text="Status: " /><Run Text="{Binding Store.ConnectionState, Mode=OneWay}" />
            <Run Text="   Version: " /><Run Text="{Binding Store.ServerVersion, Mode=OneWay, TargetNullValue='—'}" />
            <Run Text="   Hardware: " /><Run Text="{Binding Store.HardwareCount, Mode=OneWay}" />
          </TextBlock>

          <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding ApplyPollIntervalCommand}" Margin="12,0,0,0" />
            <TextBlock DockPanel.Dock="Right" Width="70" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Numeric}"
                       Text="{Binding PollIntervalMs, StringFormat='{}{0} ms'}" />
            <TextBlock Text="Update every" VerticalAlignment="Center" Width="110" Foreground="{DynamicResource Skin.Text}" />
            <Slider Minimum="250" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True"
                    Value="{Binding PollIntervalMs}" VerticalAlignment="Center" Margin="8,0" />
          </DockPanel>
          <TextBlock Text="{Binding PollStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                     Visibility="{Binding PollStatus, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="{Binding CollectorModeText}" />

          <TextBlock Text="Sensor groups" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" />
          <CheckBox Content="Drives (temperatures, wear, activity)" IsChecked="{Binding StorageEnabled}" Margin="0,10,0,0"
                    IsEnabled="{Binding CollectorSupportsSettings}" ToolTip="Reading drive health can wake sleeping hard drives." />
          <CheckBox Content="Network adapters (throughput)" IsChecked="{Binding NetworkEnabled}" Margin="0,8,0,0"
                    IsEnabled="{Binding CollectorSupportsSettings}" />
          <CheckBox Content="USB fan and AIO controllers" IsChecked="{Binding ControllersEnabled}" Margin="0,8,0,0"
                    IsEnabled="{Binding CollectorSupportsSettings}" />
          <TextBlock Style="{StaticResource Caption}" Margin="24,4,0,0" TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource Skin.Warning}"
                     Text="Leave off while FanControl (or its plugins, like FanControl.LianLi) controls a USB device: two programs talking to one controller can interfere." />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Changes are saved and the collector reopens the hardware; dashboards keep their tiles." />

          <Button Content="Open collector logs" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <!-- FanControl -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="FanControl" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="SpaceDeck never controls fans itself. The Fan profile picker asks FanControl to load one of its saved configs (File → Save as… in FanControl)." />
          <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseFanControlCommand}" Margin="12,0,0,0" />
            <TextBlock Text="{Binding FanControlLocation}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Skin.Text}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Backup -->
      <Border Style="{StaticResource Section}" Visibility="{Binding CanBackup, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Text="Backup &amp; restore" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="One file with your dashboards, alert rules, sensor names and scales, calculated sensors, automation and settings (and the collector's settings). Paired network-dashboard devices and access tokens stay on this PC. Recordings aren't included." />
          <WrapPanel Margin="0,12,0,0">
            <Button Content="Save backup…" Margin="0,0,8,8" Command="{Binding SaveBackupCommand}" />
            <Button Content="Restore from backup…" Margin="0,0,8,8" Command="{Binding RestoreBackupCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                     Visibility="{Binding BackupStatus, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
