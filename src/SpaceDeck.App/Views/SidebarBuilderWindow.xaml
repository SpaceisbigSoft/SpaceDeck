<Window x:Class="SpaceDeck.App.Views.SidebarBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidebar" Width="520" Height="680" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Skin.Background}" Foreground="{DynamicResource Skin.Text}"
        FontFamily="{DynamicResource Skin.Font.Body}">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{Binding Heading, Mode=OneTime}" Style="{StaticResource SectionTitle}" />
      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                 Text="Tick what to show; each section stacks under the last. Only hardware this PC reports is listed. You can rearrange or edit sections later on the Dashboard page." />
      <TextBlock Text="SpaceDeck hasn't received any sensors yet; connect to the collector first." Foreground="{DynamicResource Skin.Warning}"
                 Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding HasNoSensors, Converter={StaticResource VisibleWhen}}" />
      <CheckBox Content="Clock and date at the top" IsChecked="{Binding IncludeClock}" Margin="0,14,0,4" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
      <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource Skin.Rule}" BorderThickness="0,1,0,0" Padding="0,8">
              <StackPanel>
                <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,8,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Skin.Accent}" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </CheckBox>
                <ItemsControl ItemsSource="{Binding Options}" Margin="28,6,0,0" Focusable="False"
                              Visibility="{Binding IsChecked, Converter={StaticResource VisibleWhen}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2,16,2" MinWidth="190" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <DockPanel>
        <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding Widths}" SelectedItem="{Binding Width}" DisplayMemberPath="Label"
                  AutomationProperties.Name="Width" />
        <TextBlock Text="Width" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding FanModes}" SelectedItem="{Binding FanMode}" DisplayMemberPath="Label"
                  AutomationProperties.Name="Fan speeds as" ToolTip="100 % = the fan's maximum from FanControl's calibration, or else the highest speed seen" />
        <TextBlock Text="Fan speeds as" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <TextBox DockPanel.Dock="Right" Width="200" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                 AutomationProperties.Name="Dashboard name" />
        <TextBlock Text="Dashboard name" VerticalAlignment="Center" />
      </DockPanel>
      <CheckBox Content="Save as a new dashboard instead (keep the current one)" IsChecked="{Binding SaveAsNew}" Margin="0,12,0,0"
                Visibility="{Binding IsUpdate, Converter={StaticResource VisibleWhen}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="{Binding ActionText, Mode=OneTime}" IsDefault="True" Padding="18,6" Command="{Binding CreateCommand}" Style="{DynamicResource AccentButtonStyle}" />
        <Button Content="Cancel" IsCancel="True" Padding="18,6" Margin="10,0,0,0" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
