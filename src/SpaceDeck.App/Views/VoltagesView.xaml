<UserControl x:Class="SpaceDeck.App.Views.VoltagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:SpaceDeck.App.Widgets">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Rail health summary. -->
    <DockPanel Margin="0,0,0,6">
      <Ellipse Width="6" Height="6" VerticalAlignment="Center"
               Fill="{Binding OverallStatus, Converter={StaticResource StatusToBrush}}" />
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Body}" />
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!-- Right margin: Fluent scrollbars overlay content; keep rows clear of them. -->
      <Grid Margin="0,0,18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="900" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl ItemsSource="{Binding View}" Focusable="False">
        <ItemsControl.GroupStyle>
          <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <w:RailRowView Sensor="{Binding}" BandWidth="220" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
