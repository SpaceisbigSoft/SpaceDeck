<UserControl x:Class="SpaceDeck.App.Views.DashboardCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SpaceDeck.App.Controls"
             xmlns:w="clr-namespace:SpaceDeck.App.Widgets"
             xmlns:v="clr-namespace:SpaceDeck.App.Views"
             x:Name="Root">
  <!--
    One dashboard: tiles on the 12-column grid. In edit mode each tile gets an outline, a toolbar
    (settings · duplicate · delete) and a resize grip, and can be dragged; the drop target is shown as a ghost.
    Tile visuals are the DataTemplates below, picked per widget type by TileTemplateSelector.
  -->
  <UserControl.Resources>
    <v:TileTemplateSelector x:Key="TileSelector" />
    <v:PartialMissingConverter x:Key="PartialMissing" />

    <!-- Tile frame: the skin's card (Monochrome: hairline on top, no box). -->
    <Style x:Key="TileFrame" TargetType="Border" BasedOn="{StaticResource Section}">
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="TileTitle" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Visibility" Value="{Binding HasTitle, Converter={StaticResource VisibleWhen}}" />
    </Style>

    <Style x:Key="TileCaption" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Skin.Font.Mono}" />
      <Setter Property="FontSize" Value="{DynamicResource Skin.Size.Tiny}" />
      <Setter Property="Foreground" Value="{DynamicResource Skin.TextMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Big number -->
    <DataTemplate x:Key="Tile.BigNumber">
      <Border Style="{StaticResource TileFrame}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <TextBlock Margin="0,2,0,10" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource Skin.Font.Display}"
                     Typography.NumeralAlignment="Tabular" Foreground="{Binding Reading.Brush}">
            <Run Text="{Binding Reading.DisplayNumber, Mode=OneWay}" FontSize="{Binding HeroSize}" FontWeight="{DynamicResource Skin.Weight.Hero}" /><Run
                 Text="{Binding Reading.DisplayUnit, Mode=OneWay, StringFormat=' {0}'}" FontSize="{DynamicResource Skin.Size.Body}"
                 Foreground="{DynamicResource Skin.TextMuted}" />
          </TextBlock>
          <c:ValueBar Value="{Binding Reading.Value, Converter={StaticResource ToDouble}}"
                      Minimum="{Binding Reading.ScaleMinimum}" Maximum="{Binding Reading.ScaleMaximum}"
                      Thickness="{DynamicResource Skin.BarThickness}" Track="{DynamicResource Skin.Track}" Fill="{Binding Reading.Brush}" />
          <TextBlock Margin="0,8,0,0" Text="{Binding Reading.MinMaxText}" Style="{StaticResource TileCaption}"
                     Visibility="{Binding ShowMinMax, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Gauge -->
    <DataTemplate x:Key="Tile.Gauge">
      <Border Style="{StaticResource TileFrame}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <Grid Grid.Row="1" Margin="0,6,0,4">
            <c:ArcGauge Value="{Binding Reading.Value, Converter={StaticResource ToDouble}}"
                        Minimum="{Binding Reading.ScaleMinimum}" Maximum="{Binding Reading.ScaleMaximum}"
                        Thickness="{DynamicResource Skin.GaugeThickness}" Track="{DynamicResource Skin.Track}" Fill="{Binding Reading.Brush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="{Binding Reading.DisplayNumber}" HorizontalAlignment="Center" FontFamily="{DynamicResource Skin.Font.Display}"
                         FontSize="{Binding GaugeNumberSize}" FontWeight="{DynamicResource Skin.Weight.Hero}"
                         Typography.NumeralAlignment="Tabular" Foreground="{Binding Reading.Brush}" />
              <TextBlock Text="{Binding Reading.DisplayUnit}" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding Reading.MinMaxText}" Style="{StaticResource TileCaption}" HorizontalAlignment="Center"
                     Visibility="{Binding ShowMinMax, Converter={StaticResource VisibleWhen}}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Bar: name and value on one line, bar below -->
    <DataTemplate x:Key="Tile.Bar">
      <Border Style="{StaticResource TileFrame}">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Reading.DisplayValue}" Style="{StaticResource Numeric}"
                       FontSize="{DynamicResource Skin.Size.Body}" Foreground="{Binding Reading.Brush}" Margin="10,0,0,0" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <c:ValueBar Margin="0,8,0,0" Value="{Binding Reading.Value, Converter={StaticResource ToDouble}}"
                      Minimum="{Binding Reading.ScaleMinimum}" Maximum="{Binding Reading.ScaleMaximum}"
                      Thickness="{DynamicResource Skin.BarThickness}" Track="{DynamicResource Skin.Track}" Fill="{Binding Reading.Brush}" />
          <TextBlock Margin="0,6,0,0" Text="{Binding Reading.MinMaxText}" Style="{StaticResource TileCaption}"
                     Visibility="{Binding ShowMinMax, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Number + trend: the sparkline fills whatever height is left -->
    <DataTemplate x:Key="Tile.Sparkline">
      <Border Style="{StaticResource TileFrame}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <TextBlock Grid.Row="1" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource Skin.Font.Display}"
                     Typography.NumeralAlignment="Tabular" Foreground="{Binding Reading.Brush}">
            <Run Text="{Binding Reading.DisplayNumber, Mode=OneWay}" FontSize="{Binding CompactNumberSize}" FontWeight="{DynamicResource Skin.Weight.Hero}" /><Run
                 Text="{Binding Reading.DisplayUnit, Mode=OneWay, StringFormat=' {0}'}" FontSize="{DynamicResource Skin.Size.Body}"
                 Foreground="{DynamicResource Skin.TextMuted}" />
          </TextBlock>
          <c:ValueBar Grid.Row="2" Value="{Binding Reading.Value, Converter={StaticResource ToDouble}}"
                      Minimum="{Binding Reading.ScaleMinimum}" Maximum="{Binding Reading.ScaleMaximum}"
                      Thickness="{DynamicResource Skin.BarThickness}" Track="{DynamicResource Skin.Track}" Fill="{Binding Reading.Brush}" />
          <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding Reading.DisplayMax, StringFormat='max {0}'}" Style="{StaticResource TileCaption}"
                     Visibility="{Binding ShowMinMax, Converter={StaticResource VisibleWhen}}" />
          <c:Sparkline Grid.Row="4" Margin="0,10,0,0" MinHeight="20"
                       Series="{Binding Reading.History}" WindowSeconds="{Binding WindowSeconds}"
                       Stroke="{DynamicResource Skin.Line}" EndDot="{DynamicResource Skin.Accent}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Chart: one or more sensors over time -->
    <DataTemplate x:Key="Tile.Chart">
      <Border Style="{StaticResource TileFrame}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Series}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <Rectangle Width="10" Height="2" Fill="{Binding Brush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" Margin="6,0,0,0" Style="{StaticResource Caption}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasTitle, Converter={StaticResource VisibleWhen}}" />
          </DockPanel>
          <c:HistoryChart Series="{Binding Series}" WindowSeconds="{Binding WindowSeconds}"
                          GridBrush="{DynamicResource Skin.Grid}" LabelBrush="{DynamicResource Skin.TextMuted}"
                          LabelFont="{DynamicResource Skin.Font.Mono}" LineThickness="{DynamicResource Skin.LineThickness}" />
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Voltage rails -->
    <DataTemplate x:Key="Tile.Rails">
      <Border Style="{StaticResource TileFrame}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="ATX ±5 %" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Sensors}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <w:RailRowView Sensor="{Binding}" BandWidth="80" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Fans & pump -->
    <DataTemplate x:Key="Tile.Fans">
      <Border Style="{StaticResource TileFrame}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="RPM · duty" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding FanRows}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <w:FanRowView Row="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Any sensors as rows -->
    <DataTemplate x:Key="Tile.List">
      <Border Style="{StaticResource TileFrame}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                     TextTrimming="CharacterEllipsis" Visibility="{Binding HasTitle, Converter={StaticResource VisibleWhen}}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Readings}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="30">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource Numeric}" Margin="12,0,12,0"
                               Foreground="{Binding Brush}" VerticalAlignment="Center" />
                    <c:ValueBar Grid.Column="2" VerticalAlignment="Center" Value="{Binding Value, Converter={StaticResource ToDouble}}"
                                Minimum="{Binding ScaleMinimum}" Maximum="{Binding ScaleMaximum}"
                                Thickness="{DynamicResource Skin.BarThickness}" Track="{DynamicResource Skin.Track}" Fill="{Binding Brush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Label / section header -->
    <DataTemplate x:Key="Tile.Label">
      <StackPanel VerticalAlignment="Bottom">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="{DynamicResource Skin.Weight.Strong}" Foreground="{DynamicResource Skin.Text}"
                   TextTrimming="CharacterEllipsis" Visibility="{Binding HasTitle, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                   Visibility="{Binding Text, Converter={StaticResource VisibleWhen}}" />
      </StackPanel>
    </DataTemplate>

    <!-- FanControl profile buttons -->
    <DataTemplate x:Key="Tile.FanProfiles">
      <Border Style="{StaticResource TileFrame}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <ItemsControl ItemsSource="{Binding Profiles.Choices}" Focusable="False" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- A TextBlock, not a string Content: the button template would turn the first "_" of a config name into an access key. -->
                <Button Margin="0,0,8,8" Padding="12,5" AutomationProperties.Name="{Binding Name}"
                        Command="{Binding DataContext.Profiles.SwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding Name}" />
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Skin.Accent}" />
                          <Setter Property="FontWeight" Value="{DynamicResource Skin.Weight.Strong}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Skin.Accent}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Profiles.Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                     Visibility="{Binding Profiles.Status, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- One value in a section row: text, or a fan's bar (with or without its number) -->
    <DataTemplate x:Key="SectionValue">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0" ToolTip="{Binding ToolTip}">
        <c:ValueBar Width="64" VerticalAlignment="Center" Value="{Binding Fraction}" Minimum="0" Maximum="1"
                    Thickness="{DynamicResource Skin.BarThickness}" Track="{DynamicResource Skin.Track}" Fill="{Binding Brush}"
                    Visibility="{Binding ShowBar, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
        <TextBlock Text="{Binding DisplayValue}" Foreground="{Binding Brush}" VerticalAlignment="Center" TextAlignment="Right"
                   FontSize="{DynamicResource Skin.Size.Body}" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0"
                   Visibility="{Binding DisplayValue, Converter={StaticResource VisibleWhen}}" />
      </StackPanel>
    </DataTemplate>

    <!-- Hardware section (sidebar style): icon heading, hardware name, aligned rows -->
    <DataTemplate x:Key="Tile.Section">
      <Border Style="{StaticResource TileFrame}">
        <StackPanel Grid.IsSharedSizeScope="True">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding HasTitle, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding Section.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center"
                       Foreground="{DynamicResource Skin.Accent}" Margin="0,0,8,0" AutomationProperties.Name="" />
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Skin.Size.Body}" FontWeight="{DynamicResource Skin.Weight.Strong}"
                       Foreground="{DynamicResource Skin.Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Text="Nothing to show: no matching sensors, or every row is switched off." Style="{StaticResource Caption}"
                     TextWrapping="Wrap" TextTrimming="None" Visibility="{Binding Section.IsEmpty, Converter={StaticResource VisibleWhen}}" />
          <ItemsControl ItemsSource="{Binding Section.Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="20" Margin="{Binding Margin}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SectionV1" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SectionV2" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SectionV3" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             FontSize="{DynamicResource Skin.Size.Body}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Skin.TextMuted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHeading}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Skin.Text}" />
                            <Setter Property="Margin" Value="0,8,0,0" />
                            <Setter Property="Grid.ColumnSpan" Value="4" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ContentControl Grid.Column="1" Content="{Binding V1}" ContentTemplate="{StaticResource SectionValue}" Focusable="False"
                                  Visibility="{Binding V1, Converter={StaticResource VisibleWhen}}" />
                  <ContentControl Grid.Column="2" Content="{Binding V2}" ContentTemplate="{StaticResource SectionValue}" Focusable="False"
                                  Visibility="{Binding V2, Converter={StaticResource VisibleWhen}}" />
                  <ContentControl Grid.Column="3" Content="{Binding V3}" ContentTemplate="{StaticResource SectionValue}" Focusable="False"
                                  Visibility="{Binding V3, Converter={StaticResource VisibleWhen}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Per-core heat map -->
    <DataTemplate x:Key="Tile.CoreMap">
      <Border Style="{StaticResource TileFrame}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <TextBlock DockPanel.Dock="Top" Text="No per-core sensors found yet." Style="{StaticResource Caption}"
                     Visibility="{Binding HasNoCores, Converter={StaticResource VisibleWhen}}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding CoreGroups}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource TileCaption}" Margin="0,2,0,3"
                               Visibility="{Binding HasLabel, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="46" Height="38" Margin="0,0,3,3" Background="{Binding Fill}" CornerRadius="2" ToolTip="{Binding ToolTip}">
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" Foreground="{Binding Foreground}"
                                         FontFamily="{DynamicResource Skin.Font.Mono}" FontSize="13" />
                              <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{Binding Foreground}" Opacity="0.7"
                                         FontFamily="{DynamicResource Skin.Font.Mono}" FontSize="9" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Clock -->
    <DataTemplate x:Key="Tile.Clock">
      <Border Style="{StaticResource TileFrame}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <TextBlock FontFamily="{DynamicResource Skin.Font.Display}" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Skin.Text}">
            <Run Text="{Binding Clock.Time, Mode=OneWay}" FontSize="{Binding HeroSize}" FontWeight="{DynamicResource Skin.Weight.Hero}" /><Run
                 Text="{Binding Clock.Seconds, Mode=OneWay, StringFormat=' :{0}'}" FontSize="{DynamicResource Skin.Size.Body}" Foreground="{DynamicResource Skin.TextMuted}" /><Run
                 Text="{Binding Clock.Designator, Mode=OneWay, StringFormat=' {0}'}" FontSize="{DynamicResource Skin.Size.Body}" Foreground="{DynamicResource Skin.TextMuted}" />
          </TextBlock>
          <TextBlock Text="{Binding Clock.Date}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Uptime -->
    <DataTemplate x:Key="Tile.Uptime">
      <Border Style="{StaticResource TileFrame}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <TextBlock Text="{Binding Clock.Uptime}" FontFamily="{DynamicResource Skin.Font.Display}" FontSize="{Binding CompactNumberSize}"
                     FontWeight="{DynamicResource Skin.Weight.Hero}" Foreground="{DynamicResource Skin.Text}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Clock.Since}" Style="{StaticResource TileCaption}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Network & disk throughput -->
    <DataTemplate x:Key="Tile.Throughput">
      <Border Style="{StaticResource TileFrame}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                     TextTrimming="CharacterEllipsis" Visibility="{Binding HasTitle, Converter={StaticResource VisibleWhen}}" />
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                     Text="No transfer-rate sensors. Turn on Drives and/or Network adapters in Settings → Collector."
                     Visibility="{Binding HasReadings, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Readings}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Sensor.GroupName}" Style="{StaticResource TileCaption}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource Numeric}" Margin="12,0,0,0"
                               Foreground="{Binding Brush}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Several values as one line of text -->
    <DataTemplate x:Key="Tile.Text">
      <Border Style="{StaticResource TileFrame}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <TextBlock Text="{Binding TextValue}" FontFamily="{DynamicResource Skin.Font.Mono}" FontSize="{DynamicResource Skin.Size.Title}"
                     Foreground="{DynamicResource Skin.Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Sensor missing (hardware removed or renamed) -->
    <DataTemplate x:Key="Tile.Missing">
      <Border Style="{StaticResource TileFrame}" BorderBrush="{DynamicResource Skin.Rule}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource TileTitle}" />
          <TextBlock Text="{Binding MissingText}" Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,0" />
          <TextBlock Text="The hardware may have changed. Pick the sensor that replaces it, or remove this tile." Style="{StaticResource Caption}"
                     Foreground="{DynamicResource Skin.TextFaint}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                     Visibility="{Binding IsWaiting, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
          <Button Content="Replace sensor…" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4"
                  Command="{Binding DataContext.FixSensorsCommand, RelativeSource={RelativeSource AncestorType=v:DashboardCanvas}}"
                  CommandParameter="{Binding}"
                  Visibility="{Binding CanReplace, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Small square icon button used on the tile toolbar. The icon font is set on the ContentPresenter, not the
         Button: set on the Button, the tooltip inherits it and renders as boxes. -->
    <Style x:Key="TileToolButton" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Skin.TextMuted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{DynamicResource Skin.Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="12" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Skin.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Skin.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <!--
        Right margin: Fluent scrollbars overlay content; keep tiles clear of it (unscaled, so the sidebar's width math holds).
        ScaleHost carries the per-window content size (SetContentSize) as a LayoutTransform: everything inside is laid out
        at width ÷ scale and drawn back at the full width, so the content still fills it and text stays sharp.
      -->
      <Border x:Name="ScaleHost" Margin="0,6,16,12">
        <Grid x:Name="Surface">
          <!-- Drop target while dragging (under the tiles, which are transparent) -->
          <Canvas x:Name="GhostLayer" IsHitTestVisible="False">
            <Rectangle x:Name="Ghost" Visibility="Collapsed" Fill="{DynamicResource Skin.Hover}"
                       Stroke="{DynamicResource Skin.Accent}" StrokeThickness="1" StrokeDashArray="4 3" />
          </Canvas>

          <ItemsControl x:Name="TilesHost" ItemsSource="{Binding Tiles}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <c:DashboardGridPanel Loaded="Panel_Loaded" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="c:DashboardGridPanel.Col" Value="{Binding Col}" />
                <Setter Property="c:DashboardGridPanel.Row" Value="{Binding Row}" />
                <Setter Property="c:DashboardGridPanel.ColSpan" Value="{Binding ColSpan}" />
                <Setter Property="c:DashboardGridPanel.RowSpan" Value="{Binding RowSpan}" />
                <Setter Property="c:DashboardGridPanel.FitsContent" Value="{Binding FitsContent}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource TileSelector}" Focusable="False"
                                  IsHitTestVisible="{Binding EditMode, ElementName=Root, Converter={StaticResource Not}}" />

                  <!-- Some (not all) of a multi-sensor tile's sensors are gone: a small fix link (view mode). -->
                  <Button Content="⚠ Fix missing sensor" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Padding="8,2"
                          FontSize="{DynamicResource Skin.Size.Small}" Foreground="{DynamicResource Skin.Warning}"
                          Command="{Binding DataContext.FixSensorsCommand, ElementName=Root}" CommandParameter="{Binding}">
                    <Button.Visibility>
                      <MultiBinding Converter="{StaticResource PartialMissing}">
                        <Binding Path="MissingCount" />
                        <Binding Path="IsMissing" />
                        <Binding Path="IsWaiting" />
                        <Binding Path="EditMode" ElementName="Root" />
                      </MultiBinding>
                    </Button.Visibility>
                  </Button>

                  <!-- Edit chrome -->
                  <Grid Margin="-6" Visibility="{Binding EditMode, ElementName=Root, Converter={StaticResource VisibleWhen}}">
                    <Rectangle Stroke="{DynamicResource Skin.TextFaint}" StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False" />
                    <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move · double-click for settings"
                            MouseLeftButtonDown="Move_MouseDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseUp"
                            LostMouseCapture="Drag_LostCapture" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0">
                      <Button Content="&#xE713;" Style="{StaticResource TileToolButton}" ToolTip="Tile settings" AutomationProperties.Name="Tile settings"
                              Command="{Binding DataContext.EditTileCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Content="&#xE8C8;" Style="{StaticResource TileToolButton}" ToolTip="Duplicate" AutomationProperties.Name="Duplicate tile"
                              Command="{Binding DataContext.DuplicateTileCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Content="&#xE74D;" Style="{StaticResource TileToolButton}" ToolTip="Remove" AutomationProperties.Name="Remove tile"
                              Command="{Binding DataContext.DeleteTileCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <!-- Resize grip -->
                    <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                            Cursor="SizeNWSE" ToolTip="Drag to resize"
                            MouseLeftButtonDown="Resize_MouseDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseUp"
                            LostMouseCapture="Drag_LostCapture">
                      <Path Data="M 12,2 L 2,12 M 12,7 L 7,12" Stroke="{DynamicResource Skin.TextMuted}" StrokeThickness="1.2"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="This dashboard is empty. Choose “Add tile” to put sensors on it." Style="{StaticResource Caption}" FontSize="14"
                     Margin="0,8,0,0" VerticalAlignment="Top"
                     Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
        </Grid>
      </Border>
    </ScrollViewer>

    <!-- Fit to height hit its 70 % floor: the rest scrolls. Shown below the content, never over it. -->
    <TextBlock x:Name="FitHint" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Caption}" Margin="0,2,16,4"
               TextWrapping="Wrap" TextTrimming="None" IsHitTestVisible="False" />
  </Grid>
</UserControl>
