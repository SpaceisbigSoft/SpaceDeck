<UserControl x:Class="SpaceDeck.App.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SpaceDeck.App.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Search + options. -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                 VerticalContentAlignment="Center" AutomationProperties.Name="Search sensors" />
        <TextBlock Text="Search sensors (cpu temp, fan 3, 12v)" Margin="11,0,0,0" VerticalAlignment="Center"
                   IsHitTestVisible="False" Style="{StaticResource Caption}" FontSize="{DynamicResource Skin.Size.Body}"
                   Foreground="{DynamicResource Skin.TextFaint}"
                   Visibility="{Binding SearchText, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
        <CheckBox Content="Show advanced" IsChecked="{Binding ShowAdvanced}" VerticalAlignment="Center" Foreground="{DynamicResource Skin.TextMuted}"
                  ToolTip="Also show static limits, memory timings and per-engine GPU counters." />
        <CheckBox Content="Show hidden" IsChecked="{Binding ShowHidden}" Margin="18,0,0,0" VerticalAlignment="Center"
                  Foreground="{DynamicResource Skin.TextMuted}" ToolTip="Also show sensors you've hidden." />
      </StackPanel>
      <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}" FontFamily="{DynamicResource Skin.Font.Mono}"
                 Text="{Binding VisibleCount, StringFormat='{}{0} sensors'}" />
    </Grid>

    <!-- Category tabs. -->
    <DockPanel Grid.Row="1" Margin="0,16,0,4">
      <Button DockPanel.Dock="Right" Content="Add calculated sensor…" Command="{Binding AddCalculatedCommand}" Margin="8,0,0,0"
              ToolTip="A sensor computed from others: CPU + GPU power, hot spot − core, average fan speed…" />
      <Button DockPanel.Dock="Right" Content="Reset min/max" Command="{Binding ResetAllMinMaxCommand}" Margin="12,0,0,0"
              ToolTip="Start min/max over for every sensor (right-click a sensor to reset just that one)" />
      <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Double-click a sensor to rename, hide or correct it" HorizontalAlignment="Right"
                   Style="{StaticResource Caption}" Foreground="{DynamicResource Skin.TextFaint}" />
        <TextBlock Text="{Binding ResetMessage}" HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{DynamicResource Skin.Warning}"
                   Visibility="{Binding ResetMessage, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Text="{Binding Store.MinMaxSinceText}" HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{DynamicResource Skin.TextFaint}"
                   Visibility="{Binding Store.MinMaxSinceText, Converter={StaticResource VisibleWhen}}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
               ItemContainerStyle="{StaticResource ChipStyle}" Background="Transparent" BorderThickness="0"
               Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
    </DockPanel>

    <DataGrid x:Name="SensorTable" Grid.Row="2" Style="{StaticResource SensorGrid}" ItemsSource="{Binding View}"
              MouseDoubleClick="Grid_MouseDoubleClick">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Customize (rename, hide, correct)…" Command="{Binding CustomizeCommand}"
                    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          <MenuItem Header="Hide / show" Command="{Binding ToggleHiddenCommand}"
                    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          <MenuItem Header="Edit calculated sensor…" Command="{Binding EditCalculatedCommand}"
                    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          <MenuItem Header="Reset min/max" Command="{Binding ResetMinMaxCommand}"
                    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.GroupStyle>
        <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
      </DataGrid.GroupStyle>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Sensor" Width="2*" SortMemberPath="Name">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                          ToolTip="{Binding CustomizationNote}">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Skin.TextFaint}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <!-- Marks: renamed (·), corrected (±), hidden (hidden) -->
                <TextBlock Text=" ·" Foreground="{DynamicResource Skin.Accent}" VerticalAlignment="Center"
                           Visibility="{Binding IsRenamed, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text=" ±" Foreground="{DynamicResource Skin.Accent}" VerticalAlignment="Center"
                           Visibility="{Binding HasCorrection, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="  hidden" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Visibility="{Binding IsHidden, Converter={StaticResource VisibleWhen}}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Value" Width="130" SortMemberPath="Value">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayValue}" Style="{StaticResource Numeric}"
                         Foreground="{Binding Level, Converter={StaticResource StatusToBrush}}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="5 min" Width="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <c:Sparkline Series="{Binding History}" WindowSeconds="300" Height="18" Margin="0,0,16,0"
                           Stroke="{DynamicResource Skin.Line}" StrokeThickness="1" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Min" Width="120" SortMemberPath="Min">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayMin}" Style="{StaticResource Numeric}" Foreground="{DynamicResource Skin.TextMuted}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Max" Width="120" SortMemberPath="Max">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayMax}" Style="{StaticResource Numeric}" Foreground="{DynamicResource Skin.TextMuted}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Skin.TextMuted}" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
