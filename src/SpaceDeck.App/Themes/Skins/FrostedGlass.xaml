<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Frosted glass. Translucent, blurred dashboard and sidebar windows over your wallpaper; soft blue accent.
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#1C2230" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#22FFFFFF" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#7CC4FF" />
  <SolidColorBrush x:Key="Skin.Text" Color="#F5F7FA" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#CDD5E1" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#A0ABBD" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#7CC4FF" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#0B1220" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#7CC4FF" />
  <SolidColorBrush x:Key="Skin.Line" Color="#7CC4FF" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#26FFFFFF" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#5EE6A8" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FFD166" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FF6B81" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#8792A6" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#5EE6A8" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#8792A6" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FF6B81" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#7CC4FF" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#FFA48C" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#5EE6A8" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#FFD166" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#E3A8FF" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#8EE3EF" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">54</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#2EFFFFFF" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">12</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">4</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

  <!-- ── Glass ───────────────────────────────────────────────────── -->
  <!-- Dashboard and sidebar windows: a see-through tint, blurred by Windows behind it. The main window stays solid. -->
  <SolidColorBrush x:Key="Skin.Overlay.Background" Color="#991C2230" />
  <sys:String x:Key="Skin.Glass">True</sys:String>

</ResourceDictionary>
