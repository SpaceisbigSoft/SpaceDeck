<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Dracula. Purple, pink and green on a dark violet-grey ground (palette after the Dracula theme).
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#282A36" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#2B2D3A" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#3B3E51" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#44475A" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#BD93F9" />
  <SolidColorBrush x:Key="Skin.Text" Color="#F8F8F2" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#C9CBDC" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#9A9EBC" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#BD93F9" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#282A36" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#3B3E51" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#BD93F9" />
  <SolidColorBrush x:Key="Skin.Line" Color="#BD93F9" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#44475A" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#3B3E51" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#50FA7B" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#F1FA8C" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FF5555" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#7D82A6" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#50FA7B" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#7D82A6" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FF5555" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#BD93F9" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#FF79C6" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#50FA7B" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#8BE9FD" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#FFB86C" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#F1FA8C" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">54</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#313343" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#44475A" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">8</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">4</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
