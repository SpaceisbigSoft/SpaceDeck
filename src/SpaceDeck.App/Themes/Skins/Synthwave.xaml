<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Synthwave. 80s sunset: pink and cyan glow on deep purple.
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#1A1029" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#1F1431" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#31214F" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#3B2A5C" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#FF7EDB" />
  <SolidColorBrush x:Key="Skin.Text" Color="#F4EEFF" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#C9BCE6" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#9A8BC2" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#FF7EDB" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#1A1029" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#31214F" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#FF7EDB" />
  <SolidColorBrush x:Key="Skin.Line" Color="#FF7EDB" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#3B2A5C" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#31214F" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#72F1B8" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FEDE5D" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FE4450" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#7A6AA3" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#72F1B8" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#7A6AA3" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FE4450" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#FF7EDB" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#36F9F6" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#FEDE5D" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#72F1B8" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#F97E72" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#B893CE" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">54</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#241839" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#3B2A5C" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">10</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">4</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
