<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Windows 11 Fluent, light (option A). White cards on the Mica-grey ground, Windows blue accent, green for "ok".
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#EBEBEB" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#E5E5E5" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#E5E5E5" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#D1D1D1" />
  <SolidColorBrush x:Key="Skin.Text" Color="#1B1B1B" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#5C5C5C" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#767676" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#0F6CBD" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#FFFFFF" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#EDEDED" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#0F6CBD" />
  <SolidColorBrush x:Key="Skin.Line" Color="#0F6CBD" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#EDEDED" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#DFF6DD" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#107C10" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#C25E00" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#C42B1C" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#8A8A8A" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#107C10" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#8A8A8A" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#C42B1C" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#0F6CBD" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#F97316" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#16A34A" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#8B5CF6" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#DB2777" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#0D9488" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">40</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">26</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#E5E5E5" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">16,14,16,14</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">8</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Light</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">5</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">9</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
