<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Cyberpunk. Neon yellow, hot pink and cyan on near-black; hard edges, condensed numerals.
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#0A0A12" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#0E0E19" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#1C1C2E" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#2B2240" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#FCEE0A" />
  <SolidColorBrush x:Key="Skin.Text" Color="#F2F2F7" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#BDB3DA" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#8D84AE" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#FCEE0A" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#0A0A12" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#1E1A2E" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#FCEE0A" />
  <SolidColorBrush x:Key="Skin.Line" Color="#FCEE0A" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#2B2240" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#1C1C2E" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#00F0FF" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FF9E00" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FF003C" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#6C6491" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#00F0FF" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#6C6491" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FF003C" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#FCEE0A" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#FF2A6D" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#00F0FF" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#D300C5" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#FF9E00" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#9B5CFF" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Bahnschrift Condensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Code, Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">Bold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">54</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#11111D" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#3A2452" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">0</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">5</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
