<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Nord. Arctic blue-grey with frost accents (palette after the Nord theme).
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#2E3440" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#323845" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#434C5E" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#4C566A" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#88C0D0" />
  <SolidColorBrush x:Key="Skin.Text" Color="#ECEFF4" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#C5CDDB" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#9AA5B9" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#88C0D0" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#2E3440" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#434C5E" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#88C0D0" />
  <SolidColorBrush x:Key="Skin.Line" Color="#88C0D0" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#4C566A" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#434C5E" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#A3BE8C" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#EBCB8B" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#BF616A" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#7B88A1" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#A3BE8C" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#7B88A1" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#BF616A" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#88C0D0" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#D08770" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#A3BE8C" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#EBCB8B" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#B48EAD" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#81A1C1" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">54</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#3B4252" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#434C5E" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">8</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">4</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
