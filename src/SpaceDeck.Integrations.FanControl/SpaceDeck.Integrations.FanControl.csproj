<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Talks to the separately installed FanControl app (https://github.com/Rem0o/FanControl.Releases).
    SpaceDeck never writes to fans itself: it only asks FanControl to switch configuration files.
    Used by the UI app (runs in the user's session), not the collector service.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SpaceDeck.Integrations.FanControl</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpaceDeck.Collector.Tests" />
  </ItemGroup>

</Project>
