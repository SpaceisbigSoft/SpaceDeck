<UserControl x:Class="SensorDeck.App.Widgets.RailRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SensorDeck.App.Controls"
             x:Name="Root">
  <!-- One voltage rail: name · value · deviation · tolerance band (standard rails only). -->
  <Grid Margin="0,5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="90" />
      <ColumnDefinition Width="86" />
      <ColumnDefinition Width="60" />
      <ColumnDefinition Width="{Binding BandWidth, ElementName=Root}" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Sensor.Name, ElementName=Root}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
               FontFamily="{DynamicResource Skin.Font.Body}" FontSize="{DynamicResource Skin.Size.Body}"
               Foreground="{DynamicResource Skin.TextMuted}" />
    <TextBlock Grid.Column="1" Text="{Binding Sensor.DisplayValue, ElementName=Root}" VerticalAlignment="Center"
               HorizontalAlignment="Right" Margin="12,0,0,0"
               FontFamily="{DynamicResource Skin.Font.Mono}" FontSize="{DynamicResource Skin.Size.Body}"
               Foreground="{Binding Sensor.Level, ElementName=Root, Converter={StaticResource StatusToBrush}}" />
    <TextBlock Grid.Column="2" Text="{Binding Sensor.DeviationText, ElementName=Root}" VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontFamily="{DynamicResource Skin.Font.Mono}" FontSize="{DynamicResource Skin.Size.Small}"
               Foreground="{DynamicResource Skin.TextMuted}" />
    <c:ToleranceBar Grid.Column="3" Height="12" Margin="16,0,0,0" VerticalAlignment="Center"
                    Deviation="{Binding Sensor.Deviation, ElementName=Root, Converter={StaticResource ToDouble}}"
                    Track="{DynamicResource Skin.Track}" Band="{DynamicResource Skin.BandOk}"
                    Marker="{DynamicResource Skin.Fill}" OutOfTolerance="{DynamicResource Skin.Warning}"
                    Visibility="{Binding Sensor.HasTolerance, ElementName=Root, Converter={StaticResource VisibleWhen}}"
                    ToolTip="Band = ATX ±5 % tolerance; tick = nominal; mark = current reading" />
  </Grid>
</UserControl>
