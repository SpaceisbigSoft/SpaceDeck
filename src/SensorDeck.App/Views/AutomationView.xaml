<UserControl x:Class="SensorDeck.App.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,18,0">

      <!-- Now -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Open log" Command="{Binding OpenLogCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Resume rules" Command="{Binding ResumeCommand}"
                    Visibility="{Binding Automation.IsHolding, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="Automatic fan profiles" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <CheckBox Content="Switch FanControl configs automatically using the rules below" IsChecked="{Binding Enabled}" Margin="0,12,0,0" />
          <TextBlock Text="{Binding Automation.StatusText}" Foreground="{DynamicResource Skin.Text}" Margin="0,12,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Text="{Binding Automation.LastSwitchText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Visibility="{Binding Automation.LastSwitchText, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource Skin.Warning}"
                     Visibility="{Binding FanControlMissing, Converter={StaticResource VisibleWhen}}"
                     Text="FanControl wasn't found. Set its location in Settings; until then nothing can be switched." />

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="When no rule is active" Foreground="{DynamicResource Skin.Text}" />
              <TextBlock Text="Go back to the profile used before, or always use a default." Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding DefaultChoices}" SelectedItem="{Binding DefaultChoice}" VerticalAlignment="Center"
                      AutomationProperties.Name="Profile when no rule is active" />

            <StackPanel Grid.Row="1" Margin="0,12,16,0" VerticalAlignment="Center">
              <TextBlock Text="Cool-down (seconds)" Foreground="{DynamicResource Skin.Text}" />
              <TextBlock Text="Minimum time between automatic switches, so profiles never flap." Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Padding="8,5" VerticalAlignment="Center"
                     Text="{Binding CooldownSeconds}" AutomationProperties.Name="Cool-down in seconds" />

            <StackPanel Grid.Row="2" Margin="0,12,16,0" VerticalAlignment="Center">
              <TextBlock Text="After you pick a profile yourself, pause rules for (minutes)" Foreground="{DynamicResource Skin.Text}" TextWrapping="Wrap" />
              <TextBlock Text="0 = until you click Resume rules. Alerts still switch during a pause." Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Padding="8,5" VerticalAlignment="Center"
                     Text="{Binding HoldMinutes}" AutomationProperties.Name="Pause minutes after a manual switch" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Rules -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Add rule" Command="{Binding AddRuleCommand}" Style="{DynamicResource AccentButtonStyle}" />
            <TextBlock Text="Rules" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Checked top to bottom: the first active rule wins. A filled dot marks rules whose condition is true right now." />
          <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Visibility="{Binding HasNoRules, Converter={StaticResource VisibleWhen}}"
                     Text="No rules yet. Example: while eldenring.exe is running → your gaming config; when CPU Package ≥ 85 °C for 20 s → a louder config." />
          <ItemsControl ItemsSource="{Binding Rules}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Skin.Rule}" BorderThickness="0,0,0,1" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"
                              AutomationProperties.Name="Rule enabled" />
                    <Ellipse Grid.Column="1" Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center"
                             Stroke="{DynamicResource Skin.Accent}" StrokeThickness="1.5">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="Transparent" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource Skin.Accent}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Foreground="{DynamicResource Skin.Text}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  →  " Foreground="{DynamicResource Skin.TextMuted}" /><Run Text="{Binding Profile, Mode=OneWay}" FontWeight="{DynamicResource Skin.Weight.Strong}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                      <!-- Icon font on the inner TextBlock only: on the Button the tooltip would inherit it (boxes). -->
                      <Button ToolTip="Move up" Padding="8,5" Margin="0,0,4,0"
                              AutomationProperties.Name="Move up"
                              Command="{Binding DataContext.MoveUpCommand, ElementName=Root}" CommandParameter="{Binding}">
                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" />
                      </Button>
                      <Button ToolTip="Move down" Padding="8,5" Margin="0,0,8,0"
                              AutomationProperties.Name="Move down"
                              Command="{Binding DataContext.MoveDownCommand, ElementName=Root}" CommandParameter="{Binding}">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" />
                      </Button>
                      <Button Content="Edit" Margin="0,0,4,0"
                              Command="{Binding DataContext.EditRuleCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Content="Delete"
                              Command="{Binding DataContext.DeleteRuleCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Alert actions -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="When a sensor alert is active" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Alerts come from the limits on the Alerts page. An alert's profile wins over rules and pauses, and switches immediately. Sounds respect quiet hours." />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Warning" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Warning}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AlertChoices}" SelectedItem="{Binding WarningChoice}"
                      AutomationProperties.Name="Profile during a warning" />
            <CheckBox Grid.Column="2" Content="Play a sound" IsChecked="{Binding WarningSound}" Margin="16,0,0,0" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="Critical" VerticalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource Skin.Critical}" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" ItemsSource="{Binding CriticalChoices}" SelectedItem="{Binding CriticalChoice}"
                      AutomationProperties.Name="Profile during a critical alert" />
            <CheckBox Grid.Row="1" Grid.Column="2" Content="Play a sound" IsChecked="{Binding CriticalSound}" Margin="16,10,0,0" VerticalAlignment="Center" />
          </Grid>
          <CheckBox Content="Switch back when the alert ends" IsChecked="{Binding RevertOnClear}" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,24" TextWrapping="Wrap" TextTrimming="None"
                 Text="Automation runs while SensorDeck is open (including in the tray). FanControl keeps doing the actual fan control; SensorDeck only tells it which config to load." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
