<Window x:Class="SensorDeck.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Skin.Background}" Foreground="{DynamicResource Skin.Text}"
        FontFamily="{DynamicResource Skin.Font.Body}">
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="LabelText" Style="{StaticResource Caption}" Margin="0,0,0,6" />
    <!-- Dashboard and heading names: generous, but not unbounded. -->
    <TextBox x:Name="Input" Padding="8,5" MaxLength="200" AutomationProperties.LabeledBy="{Binding ElementName=LabelText}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="OK" IsDefault="True" Padding="18,6" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" />
      <Button Content="Cancel" IsCancel="True" Padding="18,6" Margin="10,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
