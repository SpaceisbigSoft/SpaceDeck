<UserControl x:Class="SensorDeck.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SensorDeck.App.Controls"
             x:Name="Root">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="36" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <!-- Chart + legend -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Window selector: text tabs; export on the right. -->
      <DockPanel Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"
                     MaxWidth="320" Visibility="{Binding ExportStatus, Converter={StaticResource VisibleWhen}}" />
          <Button Command="{Binding ExportCsvCommand}" ToolTip="Every stored sample of the charted sensors in this range, as a CSV file">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Content" Value="Export CSV…" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsExporting}" Value="True">
                    <Setter Property="Content" Value="Cancel export" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
        <ListBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Label"
                 ItemContainerStyle="{StaticResource ChipStyle}" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </DockPanel>

      <Border Grid.Row="1" Style="{StaticResource Section}">
        <Grid>
          <c:HistoryChart Series="{Binding Series}" WindowSeconds="{Binding SelectedWindow.Seconds}"
                          GridBrush="{DynamicResource Skin.Grid}" LabelBrush="{DynamicResource Skin.TextMuted}"
                          LabelFont="{DynamicResource Skin.Font.Mono}" LineThickness="{DynamicResource Skin.LineThickness}" />
          <TextBlock Text="Pick sensors on the right to chart them." Style="{StaticResource Caption}" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding Legend.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
          <TextBlock Text="Loading…" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="60,0,8,0" TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource Skin.Warning}"
                     Visibility="{Binding Hint, Converter={StaticResource VisibleWhen}}" />
        </Grid>
      </Border>

      <!-- Legend: color · name · current value · remove -->
      <ItemsControl Grid.Row="2" ItemsSource="{Binding Legend}" Focusable="False" Margin="0,14,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
              <Rectangle Width="14" Height="2" Fill="{Binding Brush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Sensor.Name}" Margin="8,0,0,0" Style="{StaticResource Body}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Sensor.DisplayValue}" Margin="10,0,0,0" Style="{StaticResource Numeric}" VerticalAlignment="Center" />
              <Button Content="×" Margin="6,0,0,0" Padding="6,0" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Skin.TextMuted}"
                      Command="{Binding DataContext.ToggleCommand, ElementName=Root}" CommandParameter="{Binding Sensor}"
                      AutomationProperties.Name="Remove from chart" ToolTip="Remove from chart" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- Sensor picker -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,4,0,8">
        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Padding="10,2" />
        <TextBlock Text="Sensors" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,6">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" AutomationProperties.Name="Search sensors" />
        <TextBlock Text="Search" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Style="{StaticResource Caption}" Foreground="{DynamicResource Skin.TextFaint}"
                   Visibility="{Binding SearchText, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
      </Grid>
      <ItemsControl Grid.Row="2" ItemsSource="{Binding Picker}" Focusable="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
        <ItemsControl.Template>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False"
                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
              <ItemsPresenter Margin="0,0,14,0" />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,12,0,4" FontWeight="{DynamicResource Skin.Weight.Strong}" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.ToggleCommand, ElementName=Root}" CommandParameter="{Binding}"
                    Style="{StaticResource RowButton}" ToolTip="Add to / remove from the chart">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Accent mark when this sensor is on the chart. -->
                <Rectangle Width="8" Height="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Fill="{DynamicResource Skin.Accent}"
                           Visibility="{Binding IsCharted, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" Style="{StaticResource Numeric}" Margin="10,0,0,0"
                           FontSize="{DynamicResource Skin.Size.Small}" Foreground="{DynamicResource Skin.TextMuted}"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
