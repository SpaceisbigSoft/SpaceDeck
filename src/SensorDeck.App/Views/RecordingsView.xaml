<UserControl x:Class="SensorDeck.App.Views.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,18,0">

      <!-- Record -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="Record a session" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="Saves every reading of every visible sensor while it runs, then a summary: peaks, averages and time spent past your alert limits. Automation rules can also record while a game runs." />
          <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Command="{Binding ToggleRecordingCommand}" Margin="10,0,0,0" Padding="16,6">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Content" Value="Start recording" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Recorder.IsRecording}" Value="True">
                      <Setter Property="Content" Value="Stop and save" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Grid>
              <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" AutomationProperties.Name="Recording name"
                       IsEnabled="{Binding Recorder.IsRecording, Converter={StaticResource Not}}" />
              <TextBlock Text="Name (optional), e.g. Cyberpunk benchmark" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                         Style="{StaticResource Caption}" Foreground="{DynamicResource Skin.TextFaint}"
                         Visibility="{Binding NewName, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            </Grid>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                      Visibility="{Binding Recorder.StatusText, Converter={StaticResource VisibleWhen}}">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Skin.Critical}" Margin="0,0,8,0" VerticalAlignment="Center"
                     Visibility="{Binding Recorder.IsRecording, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Recorder.StatusText}" Foreground="{DynamicResource Skin.Text}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Skin.Warning}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
      </Border>

      <!-- Saved -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenFolderCommand}" />
            <TextBlock Text="Saved recordings" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="Nothing recorded yet." Style="{StaticResource Caption}" Margin="0,12,0,0"
                     Visibility="{Binding HasNoItems, Converter={StaticResource VisibleWhen}}" />
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Skin.Rule}" BorderThickness="0,0,0,1" Padding="0,10">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Summary" Margin="0,0,4,0"
                              Command="{Binding DataContext.ShowSummaryCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Content="Open CSV" Margin="0,0,4,0"
                              Command="{Binding DataContext.OpenCsvCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Content="Delete"
                              Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Skin.Text}" FontWeight="{DynamicResource Skin.Weight.Strong}" />
                      <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding Highlights}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding Alerts}" TextWrapping="Wrap" FontSize="{DynamicResource Skin.Size.Small}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Skin.TextMuted}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Skin.Warning}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,24" TextWrapping="Wrap" TextTrimming="None"
                 Text="Recordings run while SensorDeck is open (including in the tray). For any time in the last 24 hours, History → Export CSV works too, even without a recording." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
