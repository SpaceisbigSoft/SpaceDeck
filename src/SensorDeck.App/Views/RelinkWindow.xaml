<Window x:Class="SensorDeck.App.Views.RelinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Replace a missing sensor" Width="560" Height="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Skin.Background}" Foreground="{DynamicResource Skin.Text}"
        FontFamily="{DynamicResource Skin.Font.Body}">
  <Window.Resources>
    <DataTemplate x:Key="SensorRow">
      <Button Command="{Binding DataContext.ChooseCommand, ElementName=Root}" CommandParameter="{Binding}" Style="{StaticResource RowButton}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding GroupName}" Style="{StaticResource Caption}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource Numeric}" Margin="12,0,0,0"
                     FontSize="{DynamicResource Skin.Size.Small}" Foreground="{DynamicResource Skin.TextMuted}" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="24,20,24,20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="This sensor isn't there any more:" Style="{StaticResource Caption}" />
      <TextBlock Text="{Binding MissingDescription}" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,2,0,0" TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                 Text="Pick what replaces it. Every tile, alert and chart that used it switches to the new sensor." />

      <TextBlock Text="Best matches" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"
                 Visibility="{Binding HasSuggestions, Converter={StaticResource VisibleWhen}}" />
      <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource SensorRow}" Focusable="False" />

      <TextBlock Text="Or search all sensors" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" AutomationProperties.Name="Search sensors" />
    </StackPanel>

    <Button DockPanel.Dock="Bottom" Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Padding="18,6" Margin="0,12,0,0" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
      <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource SensorRow}" Focusable="False" />
    </ScrollViewer>
  </DockPanel>
</Window>
