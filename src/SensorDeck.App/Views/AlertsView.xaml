<UserControl x:Class="SensorDeck.App.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <UserControl.Resources>
    <Style x:Key="LimitBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="FontFamily" Value="{DynamicResource Skin.Font.Mono}" />
      <Setter Property="FontSize" Value="{DynamicResource Skin.Size.Small}" />
    </Style>
    <Style x:Key="ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,0,8,6" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,16,0">

      <!-- Notifications -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Send test notification" Command="{Binding SendTestCommand}" />
            <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <CheckBox Content="Show Windows notifications for alerts" IsChecked="{Binding NotificationsEnabled}" Margin="0,12,0,0" />
          <CheckBox Content="Also notify for warnings (critical always notifies)" IsChecked="{Binding NotifyWarnings}" Margin="24,8,0,0"
                    IsEnabled="{Binding NotificationsEnabled}" />
          <CheckBox Content="Notify when a sensor is back to normal" IsChecked="{Binding NotifyCleared}" Margin="24,8,0,0"
                    IsEnabled="{Binding NotificationsEnabled}" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox Content="Quiet hours from" IsChecked="{Binding QuietHoursEnabled}" VerticalAlignment="Center" />
            <TextBox Text="{Binding QuietFrom}" Width="70" Padding="6,3" Margin="8,0" VerticalAlignment="Center"
                     IsEnabled="{Binding QuietHoursEnabled}" AutomationProperties.Name="Quiet hours start" />
            <TextBlock Text="to" VerticalAlignment="Center" Foreground="{DynamicResource Skin.Text}" />
            <TextBox Text="{Binding QuietTo}" Width="70" Padding="6,3" Margin="8,0" VerticalAlignment="Center"
                     IsEnabled="{Binding QuietHoursEnabled}" AutomationProperties.Name="Quiet hours end" />
          </StackPanel>
          <CheckBox Content="Critical alerts still notify and play sounds during quiet hours" IsChecked="{Binding QuietAllowCritical}" Margin="24,8,0,0"
                    IsEnabled="{Binding QuietHoursEnabled}" />
          <TextBlock Text="{Binding QuietError}" Foreground="{DynamicResource Skin.Critical}" Margin="0,6,0,0"
                     Visibility="{Binding QuietError, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                     Text="An alert fires once a reading stays past a limit for 3 updates, and ends only after it is clearly back for 5, so a value sitting on the line doesn't flood you. Alerts run while SensorDeck is open, including minimized." />
        </StackPanel>
      </Border>

      <!-- Active now -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="Right now" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Nothing needs attention." Style="{StaticResource Caption}" FontSize="14" Margin="0,10,0,0"
                     Visibility="{Binding Alerts.Active.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
          <ItemsControl ItemsSource="{Binding Alerts.Active}" Focusable="False" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="30">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Level}" FontWeight="{DynamicResource Skin.Weight.Strong}" VerticalAlignment="Center"
                             Foreground="{Binding Level, Converter={StaticResource StatusToBrush}}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Sensor.Name, Mode=OneWay}" Foreground="{DynamicResource Skin.Text}" /><Run
                         Text="{Binding Sensor.GroupName, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource Skin.TextMuted}"
                         FontSize="{DynamicResource Skin.Size.Small}" />
                  </TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding Sensor.DisplayValue}" Style="{StaticResource Numeric}" Margin="12,0"
                             VerticalAlignment="Center" Foreground="{Binding Level, Converter={StaticResource StatusToBrush}}" />
                  <TextBlock Grid.Column="3" Text="{Binding Since, Converter={StaticResource TimeText}, ConverterParameter=seconds, StringFormat='since {0}'}" Style="{StaticResource Caption}"
                             VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Limits -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock Text="Limits" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding LimitsHint}" Style="{StaticResource Caption}" Margin="0,4,0,12" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Sensor" Style="{StaticResource ColumnHead}" />
            <TextBlock Grid.Column="1" Text="Warn ≥" Style="{StaticResource ColumnHead}" />
            <TextBlock Grid.Column="2" Text="Critical ≥" Style="{StaticResource ColumnHead}" />
            <TextBlock Grid.Column="3" Text="Warn ≤" Style="{StaticResource ColumnHead}" />
            <TextBlock Grid.Column="4" Text="Critical ≤" Style="{StaticResource ColumnHead}" />
            <TextBlock Grid.Column="6" Text="On" Style="{StaticResource ColumnHead}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Skin.Rule}" BorderThickness="0,1,0,0" Padding="0,5">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="88" />
                      <ColumnDefinition Width="88" />
                      <ColumnDefinition Width="88" />
                      <ColumnDefinition Width="88" />
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Sensor.Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="{Binding Sensor.GroupName, Mode=OneWay, StringFormat=' · {0}'}" />
                      </TextBlock>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding WarningAbove}" Style="{StaticResource LimitBox}" AutomationProperties.Name="Warning at or above" />
                    <TextBox Grid.Column="2" Text="{Binding CriticalAbove}" Style="{StaticResource LimitBox}" AutomationProperties.Name="Critical at or above" />
                    <TextBox Grid.Column="3" Text="{Binding WarningBelow}" Style="{StaticResource LimitBox}" AutomationProperties.Name="Warning at or below" />
                    <TextBox Grid.Column="4" Text="{Binding CriticalBelow}" Style="{StaticResource LimitBox}" AutomationProperties.Name="Critical at or below" />
                    <TextBlock Grid.Column="5" Text="{Binding Unit}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="6" IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="Alert on" />
                    <Button Grid.Column="7" Content="{Binding ResetText}" Command="{Binding ResetCommand}" Padding="10,3" VerticalAlignment="Center"
                            Visibility="{Binding CanReset, Converter={StaticResource VisibleWhen}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Skin.Critical}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />

          <!-- Add a sensor -->
          <TextBlock Text="Add limits for another sensor" Style="{StaticResource Caption}" Margin="0,18,0,4" />
          <Grid MaxWidth="420" HorizontalAlignment="Left" Width="420">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" AutomationProperties.Name="Find a sensor" />
            <TextBlock Text="Search, e.g. “nvme” or “system fan”" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Style="{StaticResource Caption}" Foreground="{DynamicResource Skin.TextFaint}"
                       Visibility="{Binding SearchText, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False" MaxWidth="420" HorizontalAlignment="Left" Width="420" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.AddCommand, ElementName=Root}" CommandParameter="{Binding}" Style="{StaticResource RowButton}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayValue}" Style="{StaticResource Numeric}" Margin="10,0,0,0"
                               FontSize="{DynamicResource Skin.Size.Small}" Foreground="{DynamicResource Skin.TextMuted}" />
                    <TextBlock TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Skin.Text}" /><Run
                           Text="{Binding GroupName, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource Skin.TextMuted}"
                           FontSize="{DynamicResource Skin.Size.Small}" />
                    </TextBlock>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- History -->
      <Border Style="{StaticResource Section}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Open log file" Command="{Binding OpenLogFileCommand}" />
            <TextBlock Text="History" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="No alerts since SensorDeck started." Style="{StaticResource Caption}" FontSize="14" Margin="0,10,0,0"
                     Visibility="{Binding Alerts.Log.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
          <ItemsControl ItemsSource="{Binding Alerts.Log}" Focusable="False" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="28">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Time, Converter={StaticResource TimeText}, ConverterParameter=seconds}" Style="{StaticResource Numeric}"
                             FontSize="{DynamicResource Skin.Size.Small}" Foreground="{DynamicResource Skin.TextMuted}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding LevelText}" VerticalAlignment="Center"
                             Foreground="{Binding ShownLevel, Converter={StaticResource StatusToBrush}}" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding SensorName, Mode=OneWay}" Foreground="{DynamicResource Skin.Text}" /><Run
                         Text="{Binding GroupName, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource Skin.TextMuted}"
                         FontSize="{DynamicResource Skin.Size.Small}" />
                  </TextBlock>
                  <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Numeric}" Margin="12,0,0,0"
                             FontSize="{DynamicResource Skin.Size.Small}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
