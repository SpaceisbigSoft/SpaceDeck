<Application x:Class="SensorDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             ShutdownMode="OnMainWindowClose">
  <!--
    ThemeMode="Light": WPF's Fluent theme styles the stock controls (ComboBox, Slider, DataGrid…) to match the light
    Monochrome skin. The skin itself (Themes/Skins/*.xaml) is inserted at startup by SkinManager.Apply.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
