<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Dark HUD (option B). Near-black ground, cyan accent, lime for "ok", condensed display numerals (Bahnschrift ships with Windows).
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#070B10" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#0A1017" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#0F1B26" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#16212D" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#22D3EE" />
  <SolidColorBrush x:Key="Skin.Text" Color="#D7E3F0" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#8CA0B5" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#6B8096" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#22D3EE" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#070B10" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#141E29" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#22D3EE" />
  <SolidColorBrush x:Key="Skin.Line" Color="#22D3EE" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#16212D" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#1C2A38" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#A3E635" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FACC15" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FF3B5C" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#4B5D70" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#A3E635" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#4B5D70" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FF3B5C" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#22D3EE" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#FF6B3D" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#A3E635" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#FACC15" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#A78BFA" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#F472B6" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">54</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#0B121A" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#16212D" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">6</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">4</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
