<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: High contrast. White and yellow on black, bold type, larger text and thicker bars, for readability.
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#000000" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#000000" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#262626" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#FFFF00" />
  <SolidColorBrush x:Key="Skin.Text" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#E6E6E6" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#CCCCCC" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#FFFF00" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#000000" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#4D4D4D" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#FFFF00" />
  <SolidColorBrush x:Key="Skin.Line" Color="#FFFF00" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#262626" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#3FFF3F" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FFA500" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FF4D4D" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#B3B3B3" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#3FFF3F" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#B3B3B3" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FF4D4D" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#FFFF00" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#00FFFF" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#3FFF3F" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#FF66FF" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#FFA500" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#FFFFFF" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">Bold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">Bold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">Bold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">60</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">34</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">16</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">13</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#000000" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#FFFFFF" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">0</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">8</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">14</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">3</sys:Double>

</ResourceDictionary>
