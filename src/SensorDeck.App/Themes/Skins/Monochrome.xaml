<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Minimal monochrome (option C).
    Every color, font and size the app uses comes from a key in this file. Views reference these keys with
    DynamicResource only, so another skin (Fluent, Dark HUD…) is just another file with the same keys.
    Keys are prefixed "Skin." to keep them apart from WPF's own Fluent theme resources.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#FAFAF9" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#FAFAF9" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#F0EFEE" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#E7E5E4" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#111111" />
  <SolidColorBrush x:Key="Skin.Text" Color="#111111" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#57534E" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#78716C" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#C2410C" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#FFFFFF" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#E7E5E4" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#111111" />
  <SolidColorBrush x:Key="Skin.Line" Color="#111111" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#EEEDEC" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#E7E5E4" />

  <!-- Status: monochrome keeps "ok" neutral; only problems get color. -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#111111" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#C2410C" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#B91C1C" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#A8A29E" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#111111" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#A8A29E" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#B91C1C" />

  <!--
    History charts with several sensors use the series palette below (ink, then warm and cool greys, then the
    accent) so lines stay distinguishable.
  -->
  <SolidColorBrush x:Key="Skin.Series.0" Color="#111111" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#C2410C" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#78716C" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#1D4ED8" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#A8A29E" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#7C2D12" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">Light</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">Normal</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">52</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">26</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <!-- Monochrome has no boxes: a strong hairline on top and nothing else. -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="Transparent" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#111111" />
  <Thickness x:Key="Skin.Card.BorderThickness">0,1,0,0</Thickness>
  <Thickness x:Key="Skin.Card.Padding">0,12,0,0</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">0</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Light</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">2</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">3</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">1.5</sys:Double>

</ResourceDictionary>
