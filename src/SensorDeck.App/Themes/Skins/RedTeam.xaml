<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Red Team. Black and graphite with a racing-red accent (an original scheme; no brand marks).
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#0D0D0D" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#121212" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#222222" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#2A2A2A" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#E8202A" />
  <SolidColorBrush x:Key="Skin.Text" Color="#F2F2F2" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#BDBDBD" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#8C8C8C" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#E8202A" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#FFFFFF" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#262626" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#E8202A" />
  <SolidColorBrush x:Key="Skin.Line" Color="#E8202A" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#2A2A2A" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#222222" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#4ADE80" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FBBF24" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FF3D7F" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#6B6B6B" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#4ADE80" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#6B6B6B" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FF3D7F" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#E8202A" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#E5E5E5" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#FF8A3D" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#9CA3AF" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#FBBF24" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#60A5FA" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">54</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#141414" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#262626" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">2</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">4</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
