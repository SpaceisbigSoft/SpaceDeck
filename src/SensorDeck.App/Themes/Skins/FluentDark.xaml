<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Windows 11 Fluent, dark (option A). Picked automatically when Windows uses dark mode.
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#202020" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#1C1C1C" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#333333" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#3A3A3A" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#4A4A4A" />
  <SolidColorBrush x:Key="Skin.Text" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#C5C5C5" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#9A9A9A" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#4CC2FF" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#000000" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#3A3A3A" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#4CC2FF" />
  <SolidColorBrush x:Key="Skin.Line" Color="#4CC2FF" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#333333" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#1F3A1D" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#6CCB5F" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FFB454" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FF99A4" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#9A9A9A" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#6CCB5F" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#9A9A9A" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FF99A4" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#4CC2FF" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#FB923C" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#6CCB5F" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#C4B5FD" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#F9A8D4" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#5EEAD4" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">40</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">26</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#2B2B2B" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#3A3A3A" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">16,14,16,14</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">8</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">5</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">9</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
