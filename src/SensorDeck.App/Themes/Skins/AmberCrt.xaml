<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Amber CRT. A 1980s amber phosphor terminal: monospaced, amber on black.
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#0B0700" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#0E0900" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#1F1500" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#3A2A00" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#FFB000" />
  <SolidColorBrush x:Key="Skin.Text" Color="#FFB000" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#D69500" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#A67400" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#FFCC33" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#0B0700" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#2A1D00" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#FFCC33" />
  <SolidColorBrush x:Key="Skin.Line" Color="#FFCC33" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#3A2A00" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#1F1500" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#FFD966" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FF8C00" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FF3B1F" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#7A5600" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#FFD966" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#7A5600" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FF3B1F" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#FFB000" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#FF8C00" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#FFE8A3" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#D69500" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#FF6A00" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#FFD966" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">Normal</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">Normal</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">Bold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">48</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">26</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">24</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">13</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#0B0700" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#3A2A00" />
  <Thickness x:Key="Skin.Card.BorderThickness">0,1,0,0</Thickness>
  <Thickness x:Key="Skin.Card.Padding">0,12,0,0</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">0</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">6</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
