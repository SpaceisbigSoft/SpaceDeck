<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Gruvbox. Warm retro browns with orange, yellow and aqua (palette after the Gruvbox theme).
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#282828" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#2E2C2B" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#45403D" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#504945" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#FE8019" />
  <SolidColorBrush x:Key="Skin.Text" Color="#EBDBB2" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#C9B99A" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#A89984" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#FE8019" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#282828" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#45403D" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#FE8019" />
  <SolidColorBrush x:Key="Skin.Line" Color="#FE8019" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#504945" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#45403D" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#B8BB26" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FABD2F" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#FB4934" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#928374" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#B8BB26" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#928374" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#FB4934" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#FE8019" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#83A598" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#B8BB26" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#FABD2F" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#D3869B" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#8EC07C" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">SemiBold</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">54</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">28</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="#32302F" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#504945" />
  <Thickness x:Key="Skin.Card.BorderThickness">1</Thickness>
  <Thickness x:Key="Skin.Card.Padding">14,12,14,12</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">4</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">4</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">10</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">2</sys:Double>

</ResourceDictionary>
