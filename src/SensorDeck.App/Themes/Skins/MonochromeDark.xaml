<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    SKIN: Monochrome, dark. Warm near-black ground, ink becomes off-white, same single orange accent.
    Same keys as Monochrome.xaml (the reference skin); only values differ.
  -->

  <!-- ── Surfaces & text ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Background" Color="#161514" />
  <SolidColorBrush x:Key="Skin.Surface" Color="#161514" />
  <SolidColorBrush x:Key="Skin.Hover" Color="#24221F" />
  <SolidColorBrush x:Key="Skin.Rule" Color="#2E2B28" />
  <SolidColorBrush x:Key="Skin.RuleStrong" Color="#EDEBE9" />
  <SolidColorBrush x:Key="Skin.Text" Color="#EDEBE9" />
  <SolidColorBrush x:Key="Skin.TextMuted" Color="#B5AFA9" />
  <SolidColorBrush x:Key="Skin.TextFaint" Color="#8C857E" />
  <SolidColorBrush x:Key="Skin.Accent" Color="#FB923C" />
  <SolidColorBrush x:Key="Skin.OnAccent" Color="#161514" />

  <!-- ── Data marks ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Track" Color="#2E2B28" />
  <SolidColorBrush x:Key="Skin.Fill" Color="#EDEBE9" />
  <SolidColorBrush x:Key="Skin.Line" Color="#EDEBE9" />
  <SolidColorBrush x:Key="Skin.Grid" Color="#252321" />
  <SolidColorBrush x:Key="Skin.BandOk" Color="#2E2B28" />

  <!-- Status -->
  <SolidColorBrush x:Key="Skin.Ok" Color="#EDEBE9" />
  <SolidColorBrush x:Key="Skin.Warning" Color="#FB923C" />
  <SolidColorBrush x:Key="Skin.Critical" Color="#F87171" />
  <SolidColorBrush x:Key="Skin.Unknown" Color="#6B655F" />
  <SolidColorBrush x:Key="Skin.Connected" Color="#EDEBE9" />
  <SolidColorBrush x:Key="Skin.Connecting" Color="#6B655F" />
  <SolidColorBrush x:Key="Skin.Disconnected" Color="#F87171" />

  <SolidColorBrush x:Key="Skin.Series.0" Color="#EDEBE9" />
  <SolidColorBrush x:Key="Skin.Series.1" Color="#FB923C" />
  <SolidColorBrush x:Key="Skin.Series.2" Color="#A8A29E" />
  <SolidColorBrush x:Key="Skin.Series.3" Color="#60A5FA" />
  <SolidColorBrush x:Key="Skin.Series.4" Color="#6B655F" />
  <SolidColorBrush x:Key="Skin.Series.5" Color="#FDBA74" />

  <!-- ── Type ────────────────────────────────────────────────────── -->
  <!-- Windows fonts only (no bundling): Segoe UI includes a Light weight; Cascadia Mono ships with Windows Terminal. -->
  <FontFamily x:Key="Skin.Font.Display">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Skin.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Skin.Weight.Hero">Light</FontWeight>
  <FontWeight x:Key="Skin.Weight.Title">Normal</FontWeight>
  <FontWeight x:Key="Skin.Weight.Strong">SemiBold</FontWeight>

  <sys:Double x:Key="Skin.Size.Hero">52</sys:Double>
  <sys:Double x:Key="Skin.Size.Large">30</sys:Double>
  <sys:Double x:Key="Skin.Size.Title">26</sys:Double>
  <sys:Double x:Key="Skin.Size.Body">14</sys:Double>
  <sys:Double x:Key="Skin.Size.Small">12</sys:Double>
  <sys:Double x:Key="Skin.Size.Tiny">11</sys:Double>

  <!-- ── Cards (tiles and page sections) ─────────────────────────── -->
  <SolidColorBrush x:Key="Skin.Card.Background" Color="Transparent" />
  <SolidColorBrush x:Key="Skin.Card.Border" Color="#EDEBE9" />
  <Thickness x:Key="Skin.Card.BorderThickness">0,1,0,0</Thickness>
  <Thickness x:Key="Skin.Card.Padding">0,12,0,0</Thickness>
  <CornerRadius x:Key="Skin.Card.Radius">0</CornerRadius>
  <!-- Theme for WPF's stock controls (ComboBox, TextBox…): Light or Dark. -->
  <sys:String x:Key="Skin.Base">Dark</sys:String>

  <!-- ── Shape ───────────────────────────────────────────────────── -->
  <sys:Double x:Key="Skin.BarThickness">2</sys:Double>
  <sys:Double x:Key="Skin.GaugeThickness">3</sys:Double>
  <sys:Double x:Key="Skin.LineThickness">1.5</sys:Double>

</ResourceDictionary>
