<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-default</AnalysisLevel>
    <!-- Warnings fail Release builds only, so a first Debug build on a new machine isn't blocked by a stray warning. -->
    <!-- Vulnerability advisories in transitive packages (from LHM) shouldn't break Release; they still show as warnings. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <Company>SpaceDeck</Company>
    <Product>SpaceDeck</Product>
    <Version>0.1.1</Version>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
